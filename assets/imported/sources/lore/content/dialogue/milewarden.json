    "source_locale": "en",
    "text_key": "lore.warden_ruin_01_v04.text"
  },
  {
    "id": "warden_ruin_01_v05",
    "speaker": "milewarden",
    "event": "topic_ruins",
    "condition": "Linked actual ruin",
