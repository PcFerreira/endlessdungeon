  {
    "id": "warden_hello_02_v02",
    "speaker": "milewarden",
    "event": "greeting",
    "condition": "Any",
    "text": "Guildmate, could you hold this map flat? It wants to travel before I do.",
    "kind": "dialogue",
    "variant_group": "warden_hello_02",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_hello_02_v02.text"
  },
  {
    "id": "warden_hello_02_v03",
    "speaker": "milewarden",
    "event": "greeting",
    "condition": "Any",
    "text": "A Milewarden. Good company for an unfinished map.",
