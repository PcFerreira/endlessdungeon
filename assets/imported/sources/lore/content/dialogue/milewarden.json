    "variant_group": "warden_ruin_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_ruin_01_v06.text"
  },
  {
    "id": "warden_world_01",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "The multiverse collapsed into the Endless World. Every road we follow belongs to it now. I've filled nine maps and still haven't found a good place to stop.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_world_01.text"
  },
  {
    "id": "warden_world_01_v02",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "Countless worlds became the Endless World when the multiverse collapsed. I've filled nine maps of it. There's more road ahead.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_world_01_v02.text"
  },
  {
    "id": "warden_world_01_v03",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "The collapse joined the multiverse into one infinite world. Nine maps haven't made much of a dent in my pile of blank paper.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_world_01_v03.text"
  },
  {
    "id": "warden_world_01_v04",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "We walk one world now, made from the worlds that collapsed together. I've filled nine maps and kept walking.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_world_01_v04.text"
  },
  {
    "id": "warden_world_01_v05",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "The Endless World is what remains of the collapsed multiverse. I have nine maps of places I've reached, and room for another.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_world_01_v05.text"
  },
  {
    "id": "warden_world_01_v06",
    "speaker": "milewarden",
    "event": "topic_world",
    "condition": "Any",
    "text": "The multiverse came together in a single infinite world. Nine finished maps are sitting in my bag. The world is still ahead of me.",
    "kind": "dialogue",
    "variant_group": "warden_world_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_world_01_v06.text"
  }
]
