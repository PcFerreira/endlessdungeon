    "variant_group": "warden_hello_02",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_hello_02_v03.text"
  },
  {
    "id": "warden_hello_02_v04",
    "speaker": "milewarden",
    "event": "greeting",
    "condition": "Any",
    "text": "Come here, guildmate. This corner keeps folding over the place I'm trying to read.",
