[
  {
    "id": "milewarden_delivery_active",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "There is a local delivery to sort. Every crate has a mark. I wish everyone marked their maps this clearly.",
    "variant_group": "milewarden_delivery_active",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active.text"
  },
  {
    "id": "milewarden_delivery_active_v02",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "They're sorting the delivery. Every crate has a legible mark. What a comfort.",
    "variant_group": "milewarden_delivery_active",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active_v02.text"
  },
  {
    "id": "milewarden_delivery_active_v03",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "The crates are being put in order. I'd like their marker to write on my maps.",
    "variant_group": "milewarden_delivery_active",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active_v03.text"
  },
  {
    "id": "milewarden_delivery_active_v04",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "A delivery to sort, and someone has labeled it properly. I appreciate that.",
    "variant_group": "milewarden_delivery_active",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active_v04.text"
  },
  {
    "id": "milewarden_delivery_active_v05",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "The delivery marks are clear. If only every road account were as easy to follow.",
    "variant_group": "milewarden_delivery_active",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active_v05.text"
  },
  {
    "id": "milewarden_delivery_active_v06",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "They're sorting the crates in the square. A good mark saves a great deal of pointing.",
    "variant_group": "milewarden_delivery_active",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_active_v06.text"
  },
  {
    "id": "milewarden_delivery_finished",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The delivery has been received. The crates are still in the square. I recorded where they stand; nobody asked me to.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished.text"
  },
  {
    "id": "milewarden_delivery_finished_v02",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The delivery's arrived. I've written where the crates stand, though nobody required a map of them.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished_v02.text"
  },
  {
    "id": "milewarden_delivery_finished_v03",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The crates are still in the square after delivery. I found myself noting their positions.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished_v03.text"
  },
  {
    "id": "milewarden_delivery_finished_v04",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "Delivery received. I've made a small plan of the crate stacks. Habit.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished_v04.text"
  },
  {
    "id": "milewarden_delivery_finished_v05",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The crates have arrived and stayed put. I recorded their positions before realizing I had no reason to.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished_v05.text"
  },
  {
    "id": "milewarden_delivery_finished_v06",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The square has received its delivery. My notes about where it stands are more precise than anyone asked for.",
    "variant_group": "milewarden_delivery_finished",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.milewarden_delivery_finished_v06.text"
  },
  {
    "id": "milewarden_supper_active",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "Supper by the fountain. I can keep a map folded for the length of a meal. Usually.",
    "variant_group": "milewarden_supper_active",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active.text"
  },
  {
    "id": "milewarden_supper_active_v02",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "There's supper by the fountain. The map can stay folded until I've eaten.",
    "variant_group": "milewarden_supper_active",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active_v02.text"
  },
  {
    "id": "milewarden_supper_active_v03",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "A meal by the fountain is a useful reason to put my papers away.",
    "variant_group": "milewarden_supper_active",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active_v03.text"
  },
  {
    "id": "milewarden_supper_active_v04",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "We're having supper here. I shall try to leave the road out of the conversation for one bowl.",
    "variant_group": "milewarden_supper_active",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active_v04.text"
  },
  {
    "id": "milewarden_supper_active_v05",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "Supper is being set out. My map fits in its pocket better than beside a plate.",
    "variant_group": "milewarden_supper_active",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active_v05.text"
  },
  {
    "id": "milewarden_supper_active_v06",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "The fountain table is being laid. I've folded the map; that ought to count as being ready.",
    "variant_group": "milewarden_supper_active",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_active_v06.text"
  },
  {
    "id": "milewarden_supper_finished",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper is over. I learned that three people can disagree about a road without unfolding a single map.",
    "variant_group": "milewarden_supper_finished",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished.text"
  },
  {
    "id": "milewarden_supper_finished_v02",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "The meal is over. We managed a road argument with every map still folded.",
    "variant_group": "milewarden_supper_finished",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished_v02.text"
  },
  {
    "id": "milewarden_supper_finished_v03",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper finished before the argument about the road did.",
    "variant_group": "milewarden_supper_finished",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished_v03.text"
  },
  {
    "id": "milewarden_supper_finished_v04",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "We ate by the fountain. Several people disagreed about a road they'd never put on paper.",
    "variant_group": "milewarden_supper_finished",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished_v04.text"
  },
  {
    "id": "milewarden_supper_finished_v05",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "The dishes are clearing. I've learned that folded maps don't prevent route disputes.",
    "variant_group": "milewarden_supper_finished",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished_v05.text"
  },
  {
    "id": "milewarden_supper_finished_v06",
    "kind": "dialogue",
    "speaker": "milewarden",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper's done. I kept the map away from the food, though I couldn't keep roads out of the talk.",
    "variant_group": "milewarden_supper_finished",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.milewarden_supper_finished_v06.text"
  },
  {
    "id": "warden_amber_01",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "A full cup deserves a steady hand.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01.text"
  },
  {
    "id": "warden_amber_01_v02",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "Carry a full cup carefully.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01_v02.text"
  },
  {
    "id": "warden_amber_01_v03",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "Keep the water steady before you hurry.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01_v03.text"
  },
  {
    "id": "warden_amber_01_v04",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "A spilled cup is costly country out here.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01_v04.text"
  },
  {
    "id": "warden_amber_01_v05",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "Take your time with a full vessel.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01_v05.text"
  },
  {
    "id": "warden_amber_01_v06",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Amber Wastes",
    "text": "Water is worth a steadier step.",
    "kind": "dialogue",
    "variant_group": "warden_amber_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_amber_01_v06.text"
  },
  {
    "id": "warden_bye_01",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "If you find more country, write down how you reached it.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01.text"
  },
  {
    "id": "warden_bye_01_v02",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "Bring back the route as well as the name.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01_v02.text"
  },
  {
    "id": "warden_bye_01_v03",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "Write how you got there. Someone will want to follow.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01_v03.text"
  },
  {
    "id": "warden_bye_01_v04",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "Keep a note of the turns you take.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01_v04.text"
  },
  {
    "id": "warden_bye_01_v05",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "If the road reaches unfamiliar country, leave a useful account.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01_v05.text"
  },
  {
    "id": "warden_bye_01_v06",
    "speaker": "milewarden",
    "event": "farewell",
    "condition": "Any",
    "text": "Good travels, guildmate. Give your return route a page too.",
    "kind": "dialogue",
    "variant_group": "warden_bye_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_bye_01_v06.text"
  },
  {
    "id": "warden_dawn_01",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "The Office promised a complete map. We are still correcting their work.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01.text"
  },
  {
    "id": "warden_dawn_01_v02",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "The Office called its atlas final. Our margins keep growing.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01_v02.text"
  },
  {
    "id": "warden_dawn_01_v03",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "An Office clerk promised the last map. I'd like to show them my extra sheets.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01_v03.text"
  },
  {
    "id": "warden_dawn_01_v04",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "We still find the Office's old marks. We still have to check them.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01_v04.text"
  },
  {
    "id": "warden_dawn_01_v05",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "The Office meant to finish the map during the Dawn. The roads have been uncooperative ever since.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01_v05.text"
  },
  {
    "id": "warden_dawn_01_v06",
    "speaker": "milewarden",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "Old Office maps have room for certainty. I prefer a margin for corrections.",
    "kind": "dialogue",
    "variant_group": "warden_dawn_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_dawn_01_v06.text"
  },
  {
    "id": "warden_green_01",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "The oldest oaks still wear the surveyors' nails.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_green_01.text"
  },
  {
    "id": "warden_green_01_v02",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "Some old oaks have grown around the survey nails.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_green_01_v02.text"
  },
  {
    "id": "warden_green_01_v03",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "Those copper marks went into the trees before our maps.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_green_01_v03.text"
  },
  {
    "id": "warden_green_01_v04",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "The trees have kept the oldest survey marks.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_green_01_v04.text"
  },
  {
    "id": "warden_green_01_v05",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "An oak can hold a surveyor's nail longer than a book holds its page.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_green_01_v05.text"
  },
  {
    "id": "warden_green_01_v06",
    "speaker": "milewarden",
    "event": "ambient",
    "condition": "Greenwood",
    "text": "Look for old nails where the bark has grown thick.",
    "kind": "dialogue",
    "variant_group": "warden_green_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.warden_green_01_v06.text"
  },
  {
    "id": "warden_guild_01",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "We Milewardens map the roads and catalogue the mysteries along them. Copy what you find. Ask who remembers it. Leave the next guildmate a way home.",
    "kind": "dialogue",
    "variant_group": "warden_guild_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.warden_guild_01.text"
  },
  {
    "id": "warden_guild_01_v02",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "Milewardens bring back routes and accounts of strange things along them. A useful report helps the next traveler come home.",
    "kind": "dialogue",
    "variant_group": "warden_guild_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.warden_guild_01_v02.text"
  },
  {
    "id": "warden_guild_01_v03",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "Our guild maps the world and catalogues its mysteries. Write the place down before you get lost admiring it.",
    "kind": "dialogue",
    "variant_group": "warden_guild_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.warden_guild_01_v03.text"
  },
  {
    "id": "warden_guild_01_v04",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "We carry maps out and bring corrections home. If you find something strange, copy what you can and name who told you the rest.",
    "kind": "dialogue",
    "variant_group": "warden_guild_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.warden_guild_01_v04.text"
  },
  {
    "id": "warden_guild_01_v05",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "A Milewarden's journal holds roads, mysteries, and other people's accounts. Keep enough detail for a guildmate to follow your steps.",
    "kind": "dialogue",
    "variant_group": "warden_guild_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.warden_guild_01_v05.text"
  },
  {
    "id": "warden_guild_01_v06",
    "speaker": "milewarden",
    "event": "topic_guild",
    "condition": "Any",
    "text": "We're here to map what we reach and learn what lives there. The next guildmate deserves more than a dramatic name.",
