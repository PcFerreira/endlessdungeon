[
  {
    "id": "keeper_bye_01",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "Come back when you need somewhere to sit.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01.text"
  },
  {
    "id": "keeper_bye_01_v02",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "There's a place to rest when you come back.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01_v02.text"
  },
  {
    "id": "keeper_bye_01_v03",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "Go well. I'll be here when the road tires you out.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01_v03.text"
  },
  {
    "id": "keeper_bye_01_v04",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "Come back with whatever story you can carry.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01_v04.text"
  },
  {
    "id": "keeper_bye_01_v05",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "Rest here again when you need it.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01_v05.text"
  },
  {
    "id": "keeper_bye_01_v06",
    "speaker": "fountain_keeper",
    "event": "farewell",
    "condition": "Any",
    "text": "Safe travels. We'll make room for you on your return.",
    "kind": "dialogue",
    "variant_group": "keeper_bye_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_bye_01_v06.text"
  },
  {
    "id": "keeper_dawn_01",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "My grandmother said the Dawn lasted three days. Her sister said four. They argued until sunset.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01.text"
  },
  {
    "id": "keeper_dawn_01_v02",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "Grandmother counted three days of Dawn. Her sister counted four. Neither would let the other have the last word.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01_v02.text"
  },
  {
    "id": "keeper_dawn_01_v03",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "Our family has two accounts of the Dawn: three days and four. Both are in the same book.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01_v03.text"
  },
  {
    "id": "keeper_dawn_01_v04",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "Grandmother insisted the Dawn lasted three days. Her sister added a fourth every time she told it.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01_v04.text"
  },
  {
    "id": "keeper_dawn_01_v05",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "Three days, Grandmother said. Four, said her sister. Their argument lasted longer than either account.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01_v05.text"
  },
  {
    "id": "keeper_dawn_01_v06",
    "speaker": "fountain_keeper",
    "event": "topic_dawn",
    "condition": "Any",
    "text": "I've copied both family accounts of the Dawn. If I choose three days or four, somebody's ghost will complain.",
    "kind": "dialogue",
    "variant_group": "keeper_dawn_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_dawn_01_v06.text"
  },
  {
    "id": "keeper_delivery_active",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "A delivery is being sorted in the square. I offered to count the crates. They said I should count cups instead.",
    "variant_group": "keeper_delivery_active",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active.text"
  },
  {
    "id": "keeper_delivery_active_v02",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "We're sorting a delivery in the square. Apparently my cup-counting doesn't qualify me to count crates.",
    "variant_group": "keeper_delivery_active",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active_v02.text"
  },
  {
    "id": "keeper_delivery_active_v03",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "The crates are being sorted. I offered to help and was sent back to the cups.",
    "variant_group": "keeper_delivery_active",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active_v03.text"
  },
  {
    "id": "keeper_delivery_active_v04",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "A delivery's in the square. They know what belongs where better than I do.",
    "variant_group": "keeper_delivery_active",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active_v04.text"
  },
  {
    "id": "keeper_delivery_active_v05",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "They're sorting the delivery. I shall stick to vessels I can carry in one hand.",
    "variant_group": "keeper_delivery_active",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active_v05.text"
  },
  {
    "id": "keeper_delivery_active_v06",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery active",
    "text": "The square is busy with crates. I offered to count them. My reputation for cups arrived before I did.",
    "variant_group": "keeper_delivery_active",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_active_v06.text"
  },
  {
    "id": "keeper_delivery_finished",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The delivery has been received. Those crates can wait a little while. Tired hands make poor knots.",
    "variant_group": "keeper_delivery_finished",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished.text"
  },
  {
    "id": "keeper_delivery_finished_v02",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The delivery's here. Let tired hands rest before tying another knot.",
    "variant_group": "keeper_delivery_finished",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished_v02.text"
  },
  {
    "id": "keeper_delivery_finished_v03",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "Those crates have arrived safely. They can wait while the people who carried them sit down.",
    "variant_group": "keeper_delivery_finished",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished_v03.text"
  },
  {
    "id": "keeper_delivery_finished_v04",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The sorting is done for now. A crate has more patience than a tired back.",
    "variant_group": "keeper_delivery_finished",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished_v04.text"
  },
  {
    "id": "keeper_delivery_finished_v05",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "We've received the delivery. I hope its carriers find a seat before finding another job.",
    "variant_group": "keeper_delivery_finished",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished_v05.text"
  },
  {
    "id": "keeper_delivery_finished_v06",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Local delivery finished",
    "text": "The crates are in. There's time to rest before deciding which one to lift next.",
    "variant_group": "keeper_delivery_finished",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_delivery_finished_v06.text"
  },
  {
    "id": "keeper_fountain_01",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "The fountain offers rest. Keeping the steps clean is my contribution.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01.text"
  },
  {
    "id": "keeper_fountain_01_v02",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "People come here worn out. I keep the steps clear so they can sit.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01_v02.text"
  },
  {
    "id": "keeper_fountain_01_v03",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "The water does its work. I do the sweeping.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01_v03.text"
  },
  {
    "id": "keeper_fountain_01_v04",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "Rest by the fountain. You needn't earn a place beside it.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01_v04.text"
  },
  {
    "id": "keeper_fountain_01_v05",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "I tend the fountain and make sure there's room around it. Some days that means moving a very stubborn crate.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01_v05.text"
  },
  {
    "id": "keeper_fountain_01_v06",
    "speaker": "fountain_keeper",
    "event": "topic_fountain",
    "condition": "Any",
    "text": "The fountain has heard more road stories than I have. I still like listening.",
    "kind": "dialogue",
    "variant_group": "keeper_fountain_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_fountain_01_v06.text"
  },
  {
    "id": "keeper_frost_01",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "Some bells are waiting for people, too.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01.text"
  },
  {
    "id": "keeper_frost_01_v02",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "A wrapped bell can wait a long time.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01_v02.text"
  },
  {
    "id": "keeper_frost_01_v03",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "Some bells stay quiet until their traveler comes home.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01_v03.text"
  },
  {
    "id": "keeper_frost_01_v04",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "We keep a bell for people we hope to see again.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01_v04.text"
  },
  {
    "id": "keeper_frost_01_v05",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "There's waiting in a quiet bell.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01_v05.text"
  },
  {
    "id": "keeper_frost_01_v06",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Frostlands",
    "text": "A bell needn't ring to remind us of someone.",
    "kind": "dialogue",
    "variant_group": "keeper_frost_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_frost_01_v06.text"
  },
  {
    "id": "keeper_guild_01",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "Your guild keeps asking what's beyond the next hill. I keep a cup here for when you come back to tell me.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01.text"
  },
  {
    "id": "keeper_guild_01_v02",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "Milewardens come back with new names for faraway places. I make sure there's a seat when they tell us.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01_v02.text"
  },
  {
    "id": "keeper_guild_01_v03",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "Your maps go farther than my errands. Bring me a story when you return.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01_v03.text"
  },
  {
    "id": "keeper_guild_01_v04",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "The guild can keep its ink. I'll keep a cup ready for the hand that brings it home.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01_v04.text"
  },
  {
    "id": "keeper_guild_01_v05",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "You and your guildmates always want another road. I want to hear how you got back from it.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01_v05.text"
  },
  {
    "id": "keeper_guild_01_v06",
    "speaker": "fountain_keeper",
    "event": "topic_guild",
    "condition": "Any",
    "text": "When a Milewarden returns, we hear about country nobody here has seen. I like to be ready for that.",
    "kind": "dialogue",
    "variant_group": "keeper_guild_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_guild_01_v06.text"
  },
  {
    "id": "keeper_hello_01",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "Welcome to {city_name}. Take a breath. The road can wait.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01.text"
  },
  {
    "id": "keeper_hello_01_v02",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "You've reached {city_name}. Come out of the road and catch your breath.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01_v02.text"
  },
  {
    "id": "keeper_hello_01_v03",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "Welcome to {city_name}. There's no need to tell your story standing up.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01_v03.text"
  },
  {
    "id": "keeper_hello_01_v04",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "{city_name} has room for another traveler. Start with a little rest.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01_v04.text"
  },
  {
    "id": "keeper_hello_01_v05",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "First time in {city_name}? Rest your feet before you decide where to go next.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01_v05.text"
  },
  {
    "id": "keeper_hello_01_v06",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "First meeting",
    "text": "This is {city_name}. You're welcome here. The dust on your boots can wait.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_01_v06.text"
  },
  {
    "id": "keeper_hello_02",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "Rest first. You can tell me what happened afterward.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02.text"
  },
  {
    "id": "keeper_hello_02_v02",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "Sit for a moment. News keeps better than tired legs.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02_v02.text"
  },
  {
    "id": "keeper_hello_02_v03",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "You can finish that story after you've rested.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02_v03.text"
  },
  {
    "id": "keeper_hello_02_v04",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "Let the road have a minute without you. Take a seat.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02_v04.text"
  },
  {
    "id": "keeper_hello_02_v05",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "Rest your hands. Whatever happened, you don't have to tell it all at once.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02_v05.text"
  },
  {
    "id": "keeper_hello_02_v06",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Any",
    "text": "You look as though you've carried the journey far enough for today.",
    "kind": "dialogue",
    "variant_group": "keeper_hello_02",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_hello_02_v06.text"
  },
  {
    "id": "keeper_meadow_01",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "We set a place for whoever the road brings next.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01.text"
  },
  {
    "id": "keeper_meadow_01_v02",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "Leave a place open. The road hasn't sent everyone yet.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01_v02.text"
  },
  {
    "id": "keeper_meadow_01_v03",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "There's a cup for whoever reaches us next.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01_v03.text"
  },
  {
    "id": "keeper_meadow_01_v04",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "Someone we haven't met will need a seat.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01_v04.text"
  },
  {
    "id": "keeper_meadow_01_v05",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "We can make room when the next traveler comes.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01_v05.text"
  },
  {
    "id": "keeper_meadow_01_v06",
    "speaker": "fountain_keeper",
    "event": "ambient",
    "condition": "Sunlit Meadows",
    "text": "Keep one place ready for a stranger.",
    "kind": "dialogue",
    "variant_group": "keeper_meadow_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_meadow_01_v06.text"
  },
  {
    "id": "keeper_neighbors_01",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "We argue over who should mend a road. Then someone's child walks it, and suddenly everyone has a shovel.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01.text"
  },
  {
    "id": "keeper_neighbors_01_v02",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "Everyone has an opinion about a road until it needs mending. A child walking it usually settles the matter.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01_v02.text"
  },
  {
    "id": "keeper_neighbors_01_v03",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "A broken road becomes public business as soon as someone we know has to use it.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01_v03.text"
  },
  {
    "id": "keeper_neighbors_01_v04",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "Neighbors can quarrel all morning and share a shovel before supper.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01_v04.text"
  },
  {
    "id": "keeper_neighbors_01_v05",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "The loudest argument about a road often comes from two people who will mend it together.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01_v05.text"
  },
  {
    "id": "keeper_neighbors_01_v06",
    "speaker": "fountain_keeper",
    "event": "topic_neighbors",
    "condition": "Any",
    "text": "People disagree about who should do the work. They agree they want their neighbors to get home.",
    "kind": "dialogue",
    "variant_group": "keeper_neighbors_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_neighbors_01_v06.text"
  },
  {
    "id": "keeper_return_01",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "Back from {dungeon_name}? Sit down before you tell me about it.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01.text"
  },
  {
    "id": "keeper_return_01_v02",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "You made it back from {dungeon_name}. Rest first; I can listen afterward.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01_v02.text"
  },
  {
    "id": "keeper_return_01_v03",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "Back from {dungeon_name}? I was hoping to hear your steps again.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01_v03.text"
  },
  {
    "id": "keeper_return_01_v04",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "Leave {dungeon_name} outside for a moment. You're back among neighbors.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01_v04.text"
  },
  {
    "id": "keeper_return_01_v05",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "I've been wondering about your trip to {dungeon_name}. Sit while you tell me.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01_v05.text"
  },
  {
    "id": "keeper_return_01_v06",
    "speaker": "fountain_keeper",
    "event": "greeting",
    "condition": "Met speaker; returned from a linked ruin",
    "text": "So {dungeon_name} let you come home. Take a breath before the account.",
    "kind": "dialogue",
    "variant_group": "keeper_return_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_return_01_v06.text"
  },
  {
    "id": "keeper_supper_active",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "We are setting out supper by the fountain. There is always room for another cup.",
    "variant_group": "keeper_supper_active",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active.text"
  },
  {
    "id": "keeper_supper_active_v02",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "We're laying supper out by the fountain. Pull up a place while there's one spare.",
    "variant_group": "keeper_supper_active",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active_v02.text"
  },
  {
    "id": "keeper_supper_active_v03",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "Come eat with us by the fountain. I can find another cup.",
    "variant_group": "keeper_supper_active",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active_v03.text"
  },
  {
    "id": "keeper_supper_active_v04",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "There's supper to set out and a traveler to fit in. That sounds right to me.",
    "variant_group": "keeper_supper_active",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active_v04.text"
  },
  {
    "id": "keeper_supper_active_v05",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "We're making room for supper. Bring yourself; we'll sort out the cups.",
    "variant_group": "keeper_supper_active",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active_v05.text"
  },
  {
    "id": "keeper_supper_active_v06",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper active",
    "text": "Supper is going out beside the fountain. A guest is easier to find than an excuse for an empty place.",
    "variant_group": "keeper_supper_active",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_active_v06.text"
  },
  {
    "id": "keeper_supper_finished",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper has finished. We leave the cups out to dry. Someone always remembers one more story while washing up.",
    "variant_group": "keeper_supper_finished",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished.text"
  },
  {
    "id": "keeper_supper_finished_v02",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "The meal is over. The washing-up keeps producing more conversation.",
    "variant_group": "keeper_supper_finished",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished_v02.text"
  },
  {
    "id": "keeper_supper_finished_v03",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper's finished, and the cups are drying. Somebody is still telling the story they started at the table.",
    "variant_group": "keeper_supper_finished",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished_v03.text"
  },
  {
    "id": "keeper_supper_finished_v04",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "We cleared supper away. Nobody seems ready to clear the last story away.",
    "variant_group": "keeper_supper_finished",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished_v04.text"
  },
  {
    "id": "keeper_supper_finished_v05",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "The cups are washed after supper. A few neighbors linger over the drying cloths.",
    "variant_group": "keeper_supper_finished",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished_v05.text"
  },
  {
    "id": "keeper_supper_finished_v06",
    "kind": "dialogue",
    "speaker": "fountain_keeper",
    "event": "topic_local_life",
    "condition": "Town supper finished",
    "text": "Supper has ended. I leave the cups out while people finish talking.",
    "variant_group": "keeper_supper_finished",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_supper_finished_v06.text"
  },
  {
    "id": "keeper_world_01",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "When the worlds came together, my family brought a kettle and the name of their village. We've replaced the kettle twice. We still use the name.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 1,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01.text"
  },
  {
    "id": "keeper_world_01_v02",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "My family's village name survived the collapse. Their kettle lasted less well. We're on the third one now.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 2,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01_v02.text"
  },
  {
    "id": "keeper_world_01_v03",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "When the worlds joined, my family kept their village's name and brought their kettle. Two kettles later, the name remains.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 3,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01_v03.text"
  },
  {
    "id": "keeper_world_01_v04",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "The kettle my family carried from their old world is gone. So is its replacement. We still greet people with the old village name.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 4,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01_v04.text"
  },
  {
    "id": "keeper_world_01_v05",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "My family brought a village name and a kettle into the Endless World. The name has needed fewer repairs.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 5,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01_v05.text"
  },
  {
    "id": "keeper_world_01_v06",
    "speaker": "fountain_keeper",
    "event": "topic_world",
    "condition": "Any",
    "text": "We call this place by the village name my family saved at the collapse. The kettle they brought has been replaced twice.",
    "kind": "dialogue",
    "variant_group": "keeper_world_01",
    "variant": 6,
    "source_locale": "en",
    "text_key": "lore.keeper_world_01_v06.text"
  }
]
