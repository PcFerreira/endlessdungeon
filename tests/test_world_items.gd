extends SceneTree

const Inventory = preload("res://scripts/inventory.gd")
const State = preload("res://scripts/world_item_state.gd")

func _initialize() -> void:
	var bag := Inventory.new()
	var state := State.new()
	var source := {"uid": "town:0:0:chair", "item": "oak_chair", "scope": "overworld", "owner": "city:0:0", "point": [4, 8], "parent": ""}
	assert(state.pickup(source, bag))
	assert(bag.stolen_count("oak_chair") == 1 and state.wanted("city:0:0").status == "demand")
	var claim := state.wanted("city:0:0")
	claim.items.clear()
	assert(state.wanted("city:0:0").count == 1 and state.wanted("city:0:0").items.oak_chair == 1, "Cached claims cannot be mutated by a caller")
	assert(not bag.remove("oak_chair"), "Trading/discard/use cannot silently consume stolen goods")
	assert(state.place("oak_chair", "dungeon:test:floor1", Vector2(8, 8), 0, bag))
	assert(bag.count("oak_chair") == 0 and state.placed[0].owner == "city:0:0")
	var save := state.snapshot()
	assert(State.valid(save))
	var restored := State.new()
	assert(restored.restore(save))
	assert(restored.refuse_return("city:0:0") and restored.wanted("city:0:0").status == "hostile")
	assert(restored.return_stolen("city:0:0", bag))
	assert(restored.placed.is_empty() and restored.removed.is_empty() and restored.wanted("city:0:0").is_empty())
	assert(state.pickup(state.placed[0], bag))
	assert(bag.stolen_count("oak_chair") == 1 and state.placed.is_empty())
	var loaded := Inventory.new()
	assert(loaded.restore(bag.snapshot(), "mage") and loaded.stolen_count("oak_chair") == 1)
	assert(state.return_stolen("city:0:0", loaded) and loaded.count("oak_chair") == 0)
	assert(state.pickup(source, loaded))
	var second := source.duplicate(true)
	second.uid = "town:0:0:second-chair"
	assert(state.pickup(second, loaded) and state.wanted("city:0:0").count == 2, "New theft invalidates the city cache")
	assert(state.return_stolen("city:0:0", loaded) and state.wanted("city:0:0").is_empty())
	var foreign := source.duplicate(true)
	foreign.uid = "town:1:0:chair"
	foreign.owner = "city:1:0"
	assert(state.pickup(source, loaded) and state.pickup(foreign, loaded))
	assert(state.refuse_return(foreign.owner) and state.return_stolen(source.owner, loaded))
	assert(state.wanted(source.owner).is_empty() and state.wanted(foreign.owner).hostile)
	assert(state.return_stolen(foreign.owner, loaded))
	assert(state.pickup(source, loaded))
	var full := Inventory.new()
	assert(full.add("ember_shard", 999) and full.add("health_potion", 200))
	assert(full.slots_used() == full.CAPACITY)
	var before := state.snapshot()
	assert(not state.pickup({"uid": "free:chair", "item": "oak_chair", "scope": "overworld", "owner": "", "point": [3, 3], "parent": ""}, full))
	assert(state.snapshot() == before)
	assert(not state.claim_base("ruin:0:0", false) and state.claim_base("ruin:0:0", true))
	var corrupt := state.snapshot()
	corrupt.removed[source.uid].point = [NAN, 1]
	assert(not State.valid(corrupt))
	print("PASS: theft provenance, placement without laundering, city-specific restitution, hostile persistence, capacity rollback, base eligibility and malformed save rejection")
	quit()
